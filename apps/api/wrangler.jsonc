{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dni-growth",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Production domain (zone dnigrowth.com in this account). workers.dev stays on for Search Console
  // and health checks; browser pages on other hosts redirect to APP_ORIGIN.
  "routes": [
    { "pattern": "dnigrowth.com", "custom_domain": true },
    { "pattern": "www.dnigrowth.com", "custom_domain": true }
  ],

  // Landing + SPA built by apps/web. The Worker runs first only for API and app routes.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/google*.html"]
  },

  // D1 created with jurisdiction=eu (data stays in the EU).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dni-growth-db",
      "database_id": "1d423865-538d-444c-946b-30ae60828aeb",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "dni-growth-jobs" }],
    "consumers": [
      {
        "queue": "dni-growth-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "dni-growth-jobs-dlq"
      }
    ]
  },

  // Workers AI: primary engine of the single AI service (advisor, content, review, images).
  // Spend is capped in code by AI_DAILY_BUDGET_USD (never above 0.10 USD ≈ 9,090 of the 10,000 free Neurons/day).
  "ai": { "binding": "AI" },

  // Generated media (EU jurisdiction, private; served only through tenant-checked API routes).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dni-growth-media", "jurisdiction": "eu" }],

  // Cloudflare Email Service (transactional). Sending only starts when EMAIL_SENDING_ENABLED="true"
  // and MAIL_FROM belongs to a domain onboarded in Compute > Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  // Outbox drain + stuck-job recovery.
  "triggers": { "crons": ["* * * * *"] },

  // Single source of truth for public URLs: APP_ORIGIN drives cookies, OAuth redirect URIs,
  // email links, canonical URLs and the sitemap (apps/web/vite.config.ts reads it from here).
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://dnigrowth.com",
    "EMAIL_SENDING_ENABLED": "true",
    "MAIL_FROM": "hola@dnigrowth.com",
    // Hard monthly cap kept under the 3,000 emails included in Workers Paid (no overage charges).
    "EMAIL_MONTHLY_CAP": "2500",
    "GOOGLE_CLIENT_ID": "1028756015912-90c4g5idtm8tgea4s6dh92lj3ljfs2e2.apps.googleusercontent.com",
    "BILLING_ENABLED": "false",
    // GEO monitor: Gemini API on the FREE tier only (no billing account on the key project).
    "GEMINI_MODEL": "gemini-3.8-flash",
    // Free model used only when the main one is overloaded (5xx); each sample stores who answered.
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "AI_DAILY_BUDGET_USD": "0.10",
    // Free fallbacks of the AI service (each only if its secret exists): Groq, then Gemini (free tier).
    "GROQ_DAILY_REQUESTS": "900",
    "GEMINI_TEXT_MODEL": "gemini-3.5-flash-lite",
    // Leaves the rest of the free Gemini daily quota for the GEO monitor.
    "GEMINI_TEXT_DAILY": "100",
    // Lead form (organisation «DNI Growth») behind the contact form of dnigrowth.com. Public id, not a secret.
    "SITE_CONTACT_FORM_ID": "1329454a-ecaf-45fb-890d-71c2882e89db",
    // OpenRouter FREE-ONLY policy (fail-closed). Authorised OpenRouter spend: 0.00 USD, always.
    "OPENROUTER_FREE_ONLY": "true",
    "ALLOW_PAID_MODELS": "false",
    "OPENROUTER_MAX_SPEND_USD": "0",
    // Shared budget of the single key (OpenRouter free tier: 20/min, 50/day without credits).
    "OPENROUTER_DAILY_REQUESTS": "45",
    "OPENROUTER_RPM": "15",
    "OPENROUTER_ORG_DAILY": "20",
    "OPENROUTER_USER_DAILY": "10"
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
